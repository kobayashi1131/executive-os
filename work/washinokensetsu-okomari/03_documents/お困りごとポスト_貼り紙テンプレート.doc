<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word">
<head>
<meta charset="utf-8">
<style>
@page Section1 { size: 595.3pt 841.9pt; margin: 50pt 50pt 40pt 50pt; }
div.Section1 { page: Section1; }
body { font-family: "Meiryo UI", "Yu Gothic", sans-serif; color: #222; }
h1 { font-size: 26pt; color: #1F4E79; text-align: center; margin: 0 0 4pt 0; }
.sub { font-size: 11pt; color: #666; text-align: center; margin: 0 0 22pt 0; }
.big { font-size: 20pt; text-align: center; margin: 0 0 6pt 0; }
.line { font-size: 20pt; text-align: center; margin: 0 0 20pt 0; }
.box { border: 2pt solid #1F4E79; padding: 14pt; text-align: center; font-size: 20pt; margin: 0 0 22pt 0; }
table { border-collapse: collapse; width: 100%; }
th { background: #EAF1F8; color: #1F4E79; font-size: 13pt; border: 1pt solid #9DB7D5; padding: 6pt; }
td { border: 1pt solid #9DB7D5; height: 40pt; font-size: 14pt; padding: 6pt; }
h2 { font-size: 15pt; color: #1F4E79; margin: 0 0 6pt 0; }
.thanks { font-size: 12pt; color: #555; text-align: center; margin-top: 18pt; }
</style>
</head>
<body>
<div class="Section1">

