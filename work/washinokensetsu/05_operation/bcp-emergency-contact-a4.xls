   <FitToPage/>
   <Print>
    <ValidPrinterInfo/>
    <PaperSizeIndex>9</PaperSizeIndex>
    <HorizontalResolution>600</HorizontalResolution>
    <VerticalResolution>600</VerticalResolution>
   </Print>
   <DoNotDisplayGridlines/>
   <TopRowVisible>9</TopRowVisible>
   <Panes>
    <Pane>
     <Number>3</Number>
     <RangeSelection>R1C1:R1C4</RangeSelection>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="連絡先一覧">
  <Table ss:ExpandedColumnCount="4" ss:ExpandedRowCount="40" x:FullColumns="1"
   x:FullRows="1" ss:DefaultColumnWidth="80.25" ss:DefaultRowHeight="18">
   <Column ss:Index="2" ss:Width="99.75" ss:Span="1"/>
   <Column ss:Index="4" ss:Width="180"/>
   <Row ss:AutoFitHeight="0" ss:Height="26.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s63"><Data ss:Type="String">緊急連絡先一覧（BCP）</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="3" ss:StyleID="s65"><Data ss:Type="String">有限会社わしの建設／大規模災害・緊急事態発生時にこのまま掲示・携帯してください</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">1. 連絡の優先順位</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="57">
    <Cell ss:MergeAcross="3" ss:StyleID="m2353560445868"><Data ss:Type="String">①社長に電話　→　②つながらない場合は災害用伝言ダイヤル171で連絡（使い方は「使用方法」シート参照）　→　③受注済み工事のお客様担当者へ状況連絡　→　④受注済み工事を施工する職人へ状況連絡　→　⑤見積もり依頼がある会社へ連絡</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">2. 緊急連絡網（社内）</Data></Cell>
   </Row>
