 <Worksheet ss:Name="使用方法">
  <Table ss:ExpandedColumnCount="4" ss:ExpandedRowCount="19" x:FullColumns="1"
   x:FullRows="1" ss:DefaultColumnWidth="80.25" ss:DefaultRowHeight="18">
   <Column ss:Index="2" ss:Width="99.75" ss:Span="1"/>
   <Column ss:Index="4" ss:Width="180"/>
   <Row ss:AutoFitHeight="0" ss:Height="26.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s63"><Data ss:Type="String">災害時 連絡手段の使用方法（BCP）</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="3" ss:StyleID="s65"><Data ss:Type="String">有限会社わしの建設／電話連絡がつながらない時にこのシートを参照してください</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">1. 連絡手段の優先順位</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="30">
    <Cell ss:MergeAcross="3" ss:StyleID="m2353560427356"><Data ss:Type="String">①「連絡先一覧」シートの緊急連絡網（電話）で連絡　→　②つながらない場合は災害用伝言ダイヤル171（メイン）／web171（予備）を利用　→　③安否・被害状況・出社可否を確認して社長へ報告　※誰にどの順番で連絡するかは「連絡先一覧」シートの「連絡の優先順位」を参照</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">2. 災害用伝言ダイヤル（171）― 電話用（メイン）</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s75"><Data ss:Type="String">録音する</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560427396"><Data ss:Type="String">171 にダイヤル →「1」（録音）→ 自分（会社）の電話番号を市外局番から入力 → 伝言を録音（30秒程度）</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s75"><Data ss:Type="String">再生する</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560432288"><Data ss:Type="String">171 にダイヤル →「2」（再生）→ 確認したい相手の電話番号を市外局番から入力 → 伝言を再生</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">3. web171（ネット用）― 予備</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s75"><Data ss:Type="String">登録する</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560432328"><Data ss:Type="String">ブラウザで web171.jp にアクセス →「伝言を登録する」から自分（会社）の電話番号を入力し、状況を選択・入力して登録</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s75"><Data ss:Type="String">確認する</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560432348"><Data ss:Type="String">「伝言を確認する」から相手の電話番号を入力し、登録された伝言を閲覧。携帯キャリア各社の「災害用伝言板」も同様の仕組み</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="20.0625">
    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">4. 使うタイミング・共通ルール</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="30">
    <Cell ss:StyleID="s75"><Data ss:Type="String">使うタイミング</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560432388"><Data ss:Type="String">震度6弱以上の地震など大規模災害発生時（NTTが提供開始を発表）／体験利用日：毎月1日・15日、正月三が日、防災週間等に社内で訓練</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:StyleID="s75"><Data ss:Type="String">登録・確認する番号</Data></Cell>
    <Cell ss:MergeAcross="2" ss:StyleID="m2353560432912"><Data ss:Type="String">「連絡先一覧」シートの本社代表番号に統一する（全員がこの番号で登録・確認する）</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="6"/>
   <Row ss:AutoFitHeight="0" ss:Height="39.9375">
    <Cell ss:MergeAcross="3" ss:StyleID="s79"><Data ss:Type="String">※操作手順は変更される場合があるため、年1〜2回の体験利用日に社内で訓練し、最新の公式案内（NTT東日本／NTT西日本）も確認すること。一般解説は data/templates/bcp/disaster-message-dial-guide.md を参照。</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <PageSetup>
    <PageMargins x:Bottom="0.5" x:Left="0.5" x:Right="0.5" x:Top="0.5"/>
