    <Cell ss:MergeAcross="3" ss:StyleID="s67"><Data ss:Type="String">3. 受注済み工事・見積もり先の連絡先</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
    <Cell ss:MergeAcross="3" ss:StyleID="s82"><Data ss:Type="String">③受注済み工事のお客様担当者</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0">
