al="List Bullet"/><wx:uiName wx:val="箇条書き"/><w:basedOn w:val="a"/><w:rsid w:val="00E826F7"/><w:pPr><w:spacing w:after="80"/><w:ind w:left="480" w:hanging="240"/></w:pPr><w:rPr><wx:font wx:val="游ゴシック"/></w:rPr></w:style></w:styles><w:shapeDefaults><o:shapedefaults v:ext="edit" spidmax="1026"><v:textbox inset="5.85pt,.7pt,5.85pt,.7pt"/></o:shapedefaults><o:shapelayout v:ext="edit"><o:idmap v:ext="edit" data="1"/></o:shapelayout></w:shapeDefaults><w:docPr><w:view w:val="print"/><w:zoom w:percent="100"/><w:bordersDontSurroundHeader/><w:bordersDontSurroundFooter/><w:proofState w:spelling="clean" w:grammar="clean"/><w:defaultTabStop w:val="840"/><w:characterSpacingControl w:val="DontCompress"/><w:validateAgainstSchema/><w:saveInvalidXML w:val="off"/><w:ignoreMixedContent w:val="off"/><w:alwaysShowPlaceholderText w:val="off"/><w:compat><w:breakWrappedTables/><w:useFELayout/></w:compat><wsp:rsids><wsp:rsidRoot wsp:val="00E826F7"/><wsp:rsid wsp:val="00476688"/><wsp:rsid wsp:val="00D85008"/><wsp:rsid wsp:val="00E02830"/><wsp:rsid wsp:val="00E826F7"/></wsp:rsids></w:docPr><w:body><wx:sect><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t>171</w:t></w:r><w:r><w:t>／</w:t></w:r><w:r><w:t>web171 </w:t></w:r><w:r><w:t>防災訓練</w:t></w:r><w:r><w:t> </w:t></w:r><w:r><w:t>実施報告</w:t></w:r></w:p><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="1"/></w:pPr><w:r><w:t>① </w:t></w:r><w:r><w:t>実施概要</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:r><w:t>2026</w:t></w:r><w:r><w:t>年</w:t></w:r><w:r><w:t>9</w:t></w:r><w:r><w:t>月</w:t></w:r><w:r><w:t>15</w:t></w:r><w:r><w:t>日（</w:t></w:r><w:r><w:t>171</w:t></w:r><w:r><w:t>体験利用日）、社長・新井・小林の</w:t></w:r><w:r><w:t>3</w:t></w:r><w:r><w:t>名で、災害用伝言ダイヤル（</w:t></w:r><w:r><w:t>171</w:t></w:r><w:r><w:t>）および</w:t></w:r><w:r><w:t>web171</w:t></w:r><w:r><w:t>を使った訓練を実施した。実際の災害ではないため、電波状況などの通信面の問題は発生しなかった。</w:t></w:r></w:p></wx:sub-section><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="1"/></w:pPr><w:r><w:t>② </w:t></w:r><w:r><w:t>良かった点</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・他の人が残したメッセージについて、何時に残されたかなど詳細が分かり、状況把握に役立つと実感できた</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・</w:t></w:r><w:r><w:t>171</w:t></w:r><w:r><w:t>・</w:t></w:r><w:r><w:t>web171</w:t></w:r><w:r><w:t>という手段の存在と大まかな流れを、実際に体を動かして体験できた</w:t></w:r></w:p></wx:sub-section><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="1"/></w:pPr><w:r><w:t>③ </w:t></w:r><w:r><w:t>反省点・課題</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・手順や、残すメッセージの内容はうろ覚えで、</w:t></w:r><w:r><w:t>LINE</w:t></w:r><w:r><w:t>で送られてきた案内（手順・伝言テンプレート）を見ながらでないとスムーズにできなかった</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・今回は実際の災害ではないため、停電や回線混雑など、より厳しい条件下でも同じように対応できるかは未検証</w:t></w:r></w:p></wx:sub-section><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="1"/></w:pPr><w:r><w:t>④ </w:t></w:r><w:r><w:t>現場でできること（今後の対策）</w:t></w:r></w:p><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="2"/></w:pPr><w:r><w:t>手順・伝言内容をいつでも見られる状態にする</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・</w:t></w:r><w:r wsp:rsidR="00D85008"><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>災害対応</w:t></w:r><w:r><w:t>カード</w:t></w:r><w:r><w:t>を</w:t></w:r><w:r wsp:rsidR="00D85008"><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>作成し、</w:t></w:r><w:r><w:t>現場や車内に常備</w:t></w:r><w:r><w:t>、またはすぐ取り出せる形にする</w:t></w:r></w:p><w:p wsp:rsidR="00D85008" wsp:rsidRDefault="00D85008" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="fareast"/></w:rPr><w:t>・場合によっては職人にも共有し、職人のみで動いている現場がある場合はそのカードの指示に従ってもらう</w:t></w:r></w:p><w:p wsp:rsidR="00D85008" wsp:rsidRDefault="00D85008" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/></w:pPr></w:p><w:p wsp:rsidR="00D85008" wsp:rsidRDefault="00D85008" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/></w:pPr></w:p><w:p wsp:rsidR="00D85008" wsp:rsidRDefault="00D85008" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/></w:pPr></w:p><w:p wsp:rsidR="00D85008" wsp:rsidRDefault="00D85008" wsp:rsidP="00D85008"><w:pPr><w:pStyle w:val="a4"/><w:rPr><w:rFonts w:hint="fareast"/></w:rPr></w:pPr></w:p></wx:sub-section><wx:sub-section><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="2"/></w:pPr><w:r><w:t>現場での初動対応（職人さんがいる場合）</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・社員（社長・新井・小林のいずれか）が現場にいる場合：その社員が指揮を取り、作業中断の呼びかけ・点呼・被害状況確認・</w:t></w:r><w:r><w:t>171</w:t></w:r><w:r><w:t>／</w:t></w:r><w:r><w:t>web171</w:t></w:r><w:r><w:t>での会社への報告までを主導し、職人さんはその指示に従う</w:t></w:r></w:p><w:p wsp:rsidR="00E826F7" wsp:rsidRDefault="00476688"><w:pPr><w:pStyle w:val="a4"/></w:pPr><w:r><w:t>・社員が現場にいない場合：職人さん各自で安全確保</w:t></w:r><w:r><w:t>→</w:t></w:r><w:r><w:t>安全な場所に集合</w:t></w:r><w:r><w:t>→</w:t></w:r><w:r><w:t>可能であれば代表して誰かが会社へ連絡</w:t></w:r><w:r><w:t>→</w:t></w:r><w:r><w:t>指示があるまで待機</w:t></w:r></w:p></wx:sub-section></wx:sub-section><w:sectPr wsp:rsidR="00E826F7"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1985" w:right="1701" w:bottom="1701" w:left="1701" w:header="851" w:footer="992" w:gutter="0"/><w:cols w:space="425"/><w:docGrid w:type="lines" w:line-pitch="360"/></w:sectPr></wx:sect></w:body></w:wordDocument>