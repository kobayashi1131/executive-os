<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Word.Document"?>
<w:wordDocument xmlns:w="http://schemas.microsoft.com/office/word/2003/wordml"
 xmlns:wx="http://schemas.microsoft.com/office/word/2003/auxHint"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 w:macrosPresent="0" w:embeddedObjPresent="0" w:ocxPresent="0">
 <w:fonts>
  <w:defaultFonts w:ascii="Yu Gothic" w:fareast="Yu Gothic" w:h-ansi="Yu Gothic" w:cs="Yu Gothic"/>
 </w:fonts>
 <w:styles>
  <w:style w:type="paragraph" w:default="on" w:styleId="Normal">
   <w:name w:val="Normal"/>
   <w:rPr><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Title">
   <w:name w:val="Title"/>
   <w:basedOn w:val="Normal"/>
   <w:pPr><w:spacing w:after="240"/></w:pPr>
   <w:rPr><w:b/><w:sz w:val="32"/></w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading1">
   <w:name w:val="heading 1"/>
   <w:basedOn w:val="Normal"/>
   <w:pPr><w:spacing w:before="300" w:after="120"/></w:pPr>
   <w:rPr><w:b/><w:sz w:val="26"/></w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading2">
   <w:name w:val="heading 2"/>
   <w:basedOn w:val="Normal"/>
   <w:pPr><w:spacing w:before="200" w:after="80"/></w:pPr>
   <w:rPr><w:b/><w:sz w:val="22"/></w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="ListBullet">
   <w:name w:val="List Bullet"/>
   <w:basedOn w:val="Normal"/>
   <w:pPr><w:ind w:left="480" w:hanging="240"/><w:spacing w:after="80"/></w:pPr>
  </w:style>
 </w:styles>
 <w:body>
  <w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t>171／web171 防災訓練 実施報告</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>① 実施概要</w:t></w:r></w:p>
  <w:p><w:r><w:t>2026年9月15日（171体験利用日）、社長・新井・小林の3名で、災害用伝言ダイヤル（171）およびweb171を使った訓練を実施した。実際の災害ではないため、電波状況などの通信面の問題は発生しなかった。</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>② 良かった点</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・他の人が残したメッセージについて、何時に残されたかなど詳細が分かり、状況把握に役立つと実感できた</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・171・web171という手段の存在と大まかな流れを、実際に体を動かして体験できた</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>③ 反省点・課題</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・手順や、残すメッセージの内容はうろ覚えで、LINEで送られてきた案内（手順・伝言テンプレート）を見ながらでないとスムーズにできなかった</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・今回は実際の災害ではないため、停電や回線混雑など、より厳しい条件下でも同じように対応できるかは未検証</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>④ 現場でできること（今後の対策）</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>手順・伝言内容をいつでも見られる状態にする</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・緊急連絡カードを現場や車内に常備、またはすぐ取り出せる形にする</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・月1〜2回の171体験利用日を活用し、訓練を継続して慣れておく</w:t></w:r></w:p>

  <w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>現場での初動対応（職人さんがいる場合）</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・社員（社長・新井・小林のいずれか）が現場にいる場合：その社員が指揮を取り、作業中断の呼びかけ・点呼・被害状況確認・171／web171での会社への報告までを主導し、職人さんはその指示に従う</w:t></w:r></w:p>
  <w:p><w:pPr><w:pStyle w:val="ListBullet"/></w:pPr><w:r><w:t>・社員が現場にいない場合：職人さん各自で安全確保→安全な場所に集合→可能であれば代表して誰かが会社へ連絡→指示があるまで待機</w:t></w:r></w:p>
 </w:body>
</w:wordDocument>
